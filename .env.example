# Copia estas variables en Vercel > Project > Settings > Environment Variables.
# NUNCA subas los valores reales a GitHub.

# Dirección pública de la web (sin "/" al final)
NEXT_PUBLIC_SITE_URL=https://www.tehiceunregalo.cl

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # SECRETA

# Mercado Pago > Tus integraciones > tu aplicación > Credenciales
MP_ACCESS_TOKEN=APP_USR-...                 # SECRETA (TEST-... para pruebas)

# Frase larga al azar (40+ caracteres) para cifrar los datos bancarios. SECRETA.
# Si la cambias, los datos bancarios ya guardados no se podrán leer.
ENCRYPTION_KEY=

# Correos que pueden entrar al panel /admin, separados por coma
ADMIN_EMAILS=tu-correo@ejemplo.cl

# Comisión de la plataforma sobre lo reunido (porcentaje). Ej: 5
COMISION_PCT=0
